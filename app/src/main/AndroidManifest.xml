<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    <!--
      Pages (docs/pages.md): website pages, and single-file pages whose per-page network switch
      the user turned on, need the network. The launcher itself sends nothing of its own.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Query other launchable activities so LauncherApps can enumerate the inventory. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      dataExtractionRules: backups leave out the WebView profile (website cookies, page storage); see
      res/xml/data_extraction_rules.xml.
      usesCleartextTraffic: website pages accept http:// addresses (shown "not https", shape and word);
      without this, Android refuses every http page (net::ERR_CLEARTEXT_NOT_PERMITTED). The launcher
      itself still sends nothing of its own. Owner decision recorded in docs/pages.md.
    -->
    <application
        android:name=".SphereApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SphereLauncher">

        <!-- WebView (pages): no usage metrics to Google. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <!--
          WebView (pages): Safe Browsing OFF, the owner's decision (2026-11-04), so no visited URL is
          checked with Google. Cost: no warning before a known-malicious site. Also set off on every
          WebView the launcher creates (WebSettings.setSafeBrowsingEnabled(false)).
        -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection"
            android:theme="@style/Theme.SphereLauncher">

            <!-- Standard launch -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Makes this a home app: HOME + DEFAULT so the home button returns here -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="com.bos.sphere.core.data.SphereNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
