<?xml version="1.0" encoding="utf-8"?>
<!--
  NFR-18: usage history, search indexes, notification content and the local snapshots stay on the device. They are
  excluded from system cloud backup and from device-to-device transfer. Cloud backup is excluded as a whole (the root rule below); the
  user's own export file (Ground Control, Backup) is the portable copy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="launch_history.xml" />
        <exclude domain="sharedpref" path="search_habits.xml" />
        <exclude domain="sharedpref" path="steps.xml" />
        <exclude domain="sharedpref" path="weather.xml" />
        <exclude domain="sharedpref" path="crash_loop.xml" />
        <exclude domain="sharedpref" path="palette.xml" />
        <exclude domain="sharedpref" path="liftoff_spikes.xml" />
        <exclude domain="sharedpref" path="desktop_surface.xml" />
        <exclude domain="sharedpref" path="liftoff_misc.xml" />
        <exclude domain="sharedpref" path="device_checks.xml" />
        <exclude domain="sharedpref" path="device_bound.xml" />
        <exclude domain="sharedpref" path="launchpad_groups.xml" />
        <exclude domain="sharedpref" path="comms_widgets.xml" />
        <exclude domain="sharedpref" path="preview_window.xml" />
        <exclude domain="sharedpref" path="edit_chrome.xml" />
        <exclude domain="sharedpref" path="theme_undo.xml" />
        <exclude domain="sharedpref" path="grant_history.xml" />
        <exclude domain="file" path="palette-files.idx" />
        <exclude domain="file" path="crash-reports" />
        <exclude domain="file" path="crash_recovery_report.txt" />
        <exclude domain="file" path="crash_recovery_streak.txt" />
        <exclude domain="file" path="crash_recovery_exit_seen.txt" />
        <exclude domain="file" path="crash_recovery_last_shown.txt" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="state/snapshots" />
        <exclude domain="file" path="index" />
        <exclude domain="file" path="notifications" />
        <exclude domain="file" path="usage" />
        <exclude domain="file" path="wallpapers" />
        <exclude domain="file" path="home_layout_legacy.json" />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="launch_history.xml" />
        <exclude domain="sharedpref" path="search_habits.xml" />
        <exclude domain="sharedpref" path="steps.xml" />
        <exclude domain="sharedpref" path="weather.xml" />
        <exclude domain="sharedpref" path="crash_loop.xml" />
        <exclude domain="sharedpref" path="palette.xml" />
        <exclude domain="sharedpref" path="liftoff_spikes.xml" />
        <exclude domain="sharedpref" path="desktop_surface.xml" />
        <exclude domain="sharedpref" path="liftoff_misc.xml" />
        <exclude domain="sharedpref" path="device_checks.xml" />
        <exclude domain="sharedpref" path="device_bound.xml" />
        <exclude domain="sharedpref" path="launchpad_groups.xml" />
        <exclude domain="sharedpref" path="comms_widgets.xml" />
        <exclude domain="sharedpref" path="preview_window.xml" />
        <exclude domain="sharedpref" path="edit_chrome.xml" />
        <exclude domain="sharedpref" path="theme_undo.xml" />
        <exclude domain="sharedpref" path="grant_history.xml" />
        <exclude domain="file" path="palette-files.idx" />
        <exclude domain="file" path="crash-reports" />
        <exclude domain="file" path="crash_recovery_report.txt" />
        <exclude domain="file" path="crash_recovery_streak.txt" />
        <exclude domain="file" path="crash_recovery_exit_seen.txt" />
        <exclude domain="file" path="crash_recovery_last_shown.txt" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="state/snapshots" />
        <exclude domain="file" path="index" />
        <exclude domain="file" path="notifications" />
        <exclude domain="file" path="usage" />
        <exclude domain="file" path="wallpapers" />
        <exclude domain="file" path="home_layout_legacy.json" />
    </device-transfer>
</data-extraction-rules>
