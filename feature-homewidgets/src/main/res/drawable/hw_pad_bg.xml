<?xml version="1.0" encoding="utf-8"?>
<!-- A pad, row or control: faint tint with a hairline, rippling on touch. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/hw_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hw_pad" />
            <stroke android:width="1dp" android:color="@color/hw_pad_stroke" />
            <corners android:radius="@android:dimen/system_app_widget_inner_radius" />
        </shape>
    </item>
</ripple>
