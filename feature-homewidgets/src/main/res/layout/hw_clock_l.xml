<?xml version="1.0" encoding="utf-8"?>
<!-- Gate clock, large: time, date and the next alarm. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/hw_padding">

    <TextClock
        android:id="@+id/hw_clock_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="64sp"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-light"
        android:fontFeatureSettings="tnum"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:gravity="start|bottom"
        android:maxLines="1"
        android:textColor="@color/hw_ink_bright" />

    <TextClock
        android:id="@+id/hw_clock_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:format12Hour="EEE d MMM"
        android:format24Hour="EEE d MMM"
        android:letterSpacing="0.13"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/hw_ink_dim"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hw_clock_alarm_glyph"
            android:layout_width="@dimen/hw_glyph_small"
            android:layout_height="@dimen/hw_glyph_small"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/hw_ic_alarm" />

        <TextView
            android:id="@+id/hw_clock_alarm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hw_ink"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
