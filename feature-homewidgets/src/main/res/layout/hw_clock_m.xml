<?xml version="1.0" encoding="utf-8"?>
<!-- Gate clock, medium: the time and the date (both TextClocks: the launcher keeps them current). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/hw_padding">

    <TextClock
        android:id="@+id/hw_clock_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="56sp"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-light"
        android:fontFeatureSettings="tnum"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:gravity="start|bottom"
        android:maxLines="1"
        android:textColor="@color/hw_ink_bright" />

    <TextClock
        android:id="@+id/hw_clock_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:format12Hour="EEE d MMM"
        android:format24Hour="EEE d MMM"
        android:letterSpacing="0.13"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/hw_ink_dim"
        android:textSize="13sp" />
</LinearLayout>
