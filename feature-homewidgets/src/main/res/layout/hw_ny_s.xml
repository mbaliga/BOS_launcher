<?xml version="1.0" encoding="utf-8"?>
<!--
  Needs you, small: the total, how many apps and the "as of" time (wrapping to a second line when
  narrow). One tap target (Sphere's hub).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/hw_padding"
    android:paddingVertical="4dp">

    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/hw_ic_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hw_ny_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hw_ink_bright"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hw_ny_message_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/hw_ink_dim"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
