<?xml version="1.0" encoding="utf-8"?>
<!-- App pads, large: six apps in two rows of three, with their names. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/hw_pad_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/hw_pad_bg"
            android:gravity="center"
            android:minHeight="@dimen/hw_touch"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/hw_pad_1_icon"
                android:layout_width="@dimen/hw_pad_icon"
                android:layout_height="@dimen/hw_pad_icon"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/hw_ic_apps" />

            <TextView
                android:id="@+id/hw_pad_1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/hw_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hw_pad_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/hw_pad_bg"
            android:gravity="center"
            android:minHeight="@dimen/hw_touch"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/hw_pad_2_icon"
                android:layout_width="@dimen/hw_pad_icon"
                android:layout_height="@dimen/hw_pad_icon"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/hw_ic_apps" />

            <TextView
                android:id="@+id/hw_pad_2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/hw_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hw_pad_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/hw_pad_bg"
            android:gravity="center"
            android:minHeight="@dimen/hw_touch"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/hw_pad_3_icon"
                android:layout_width="@dimen/hw_pad_icon"
                android:layout_height="@dimen/hw_pad_icon"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/hw_ic_apps" />

            <TextView
                android:id="@+id/hw_pad_3_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/hw_ink"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/hw_pad_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/hw_pad_bg"
            android:gravity="center"
            android:minHeight="@dimen/hw_touch"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/hw_pad_4_icon"
                android:layout_width="@dimen/hw_pad_icon"
                android:layout_height="@dimen/hw_pad_icon"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/hw_ic_apps" />

            <TextView
                android:id="@+id/hw_pad_4_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/hw_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hw_pad_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/hw_pad_bg"
            android:gravity="center"
            android:minHeight="@dimen/hw_touch"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/hw_pad_5_icon"
                android:layout_width="@dimen/hw_pad_icon"
                android:layout_height="@dimen/hw_pad_icon"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/hw_ic_apps" />

            <TextView
                android:id="@+id/hw_pad_5_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/hw_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hw_pad_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/hw_pad_bg"
            android:gravity="center"
            android:minHeight="@dimen/hw_touch"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/hw_pad_6_icon"
                android:layout_width="@dimen/hw_pad_icon"
                android:layout_height="@dimen/hw_pad_icon"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/hw_ic_apps" />

            <TextView
                android:id="@+id/hw_pad_6_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/hw_ink"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
