<?xml version="1.0" encoding="utf-8"?>
<!--
  A widget that has a state to report instead of data: not connected, nothing playing, connecting,
  choose apps, couldn't read. Glyph + title + body (a shape and words; never colour alone), and
  an "as of" line where the state can lapse. Medium and large; hw_state_s is the small one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/hw_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hw_state_glyph"
            android:layout_width="@dimen/hw_glyph"
            android:layout_height="@dimen/hw_glyph"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/hw_ic_warning" />

        <TextView
            android:id="@+id/hw_state_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/hw_ink_bright"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hw_state_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/hw_ink_dim"
        android:textSize="12sp" />

    <!-- When the state can lapse while Sphere isn't running (nothing playing, connecting). -->
    <TextView
        android:id="@+id/hw_state_asof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/hw_ink_dim"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
