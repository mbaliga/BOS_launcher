<?xml version="1.0" encoding="utf-8"?>
<!--
  A state, small: glyph, a one-line title and two lines of body (or the "as of" time, where the
  state can lapse), compact like the other small layouts. One tap target.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/hw_padding"
    android:paddingVertical="4dp">

    <ImageView
        android:id="@+id/hw_state_glyph"
        android:layout_width="@dimen/hw_glyph"
        android:layout_height="@dimen/hw_glyph"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/hw_ic_warning" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hw_state_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hw_ink_bright"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/hw_state_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/hw_ink_dim"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
