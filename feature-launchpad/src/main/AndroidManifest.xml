<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- STR-11: the digest as a home widget (AppWidgetProvider and RemoteViews; no service, no network). -->
        <receiver
            android:name="com.bos.sphere.ui.DigestWidgetProvider"
            android:exported="false"
            android:label="@string/digest_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/digest_widget_info" />
        </receiver>
    </application>
</manifest>
