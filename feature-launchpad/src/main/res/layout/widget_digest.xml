<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/digest_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_digest_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/digest_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#E7E9F0"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/digest_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#9AA1B2"
        android:textSize="12sp" />

    <TextView android:id="@+id/digest_row0" style="@style/DigestWidgetRow" />
    <TextView android:id="@+id/digest_row1" style="@style/DigestWidgetRow" />
    <TextView android:id="@+id/digest_row2" style="@style/DigestWidgetRow" />
    <TextView android:id="@+id/digest_row3" style="@style/DigestWidgetRow" />
</LinearLayout>
